{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/passioncode-ai/project-observatory-dashboard/observatory/engine/schemas/agents.schema.json",
  "title": "registry/agents.json \u2014 the agents installed on this machine",
  "description": "Generated by collectors/scan_agents.py (the tick's collector) and collectors/emit_registry.py (the MCP join and the dates); mirrored unchanged into the wiki's inventory/ by tools/project_into_vault.py, which adds only the `_`-prefixed header. Never edited by hand. Rows come from fabric-service/0.1 descriptors only; nothing of `auth` is ever written.",
  "type": "object",
  "required": [
    "schema_version",
    "updated_on",
    "stale",
    "sources",
    "agents",
    "removed",
    "totals",
    "degraded",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_on": {
      "$ref": "#/$defs/date"
    },
    "scanned_on": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "required": [
        "fabric_services",
        "launchd",
        "mcp_inventory"
      ],
      "properties": {
        "fabric_services": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "read",
                "absent",
                "unreadable"
              ]
            },
            "directory": {
              "type": "string"
            },
            "descriptors": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "launchd": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "read",
                "failed",
                "not-applicable",
                "skipped",
                "not-needed",
                "not-measured"
              ]
            }
          },
          "additionalProperties": false
        },
        "mcp_inventory": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "read",
                "absent"
              ]
            },
            "scanned_on": {
              "anyOf": [
                {
                  "$ref": "#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "removed": {
      "description": "Ids listed by the previous document whose descriptor is gone.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/agentId"
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "agents",
        "local",
        "remote",
        "valid",
        "invalid",
        "carried",
        "manifests_pinned",
        "by_supervisor_state",
        "mcp"
      ],
      "properties": {
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "local": {
          "type": "integer",
          "minimum": 0
        },
        "remote": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "manifests_pinned": {
          "type": "integer",
          "minimum": 0
        },
        "by_supervisor_state": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/supervisorState"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Rows measured by this scan, by state; carried rows are not counted."
        },
        "mcp": {
          "description": "null when no MCP inventory was read: unmeasured, not zero.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "attributed",
                "ambiguous",
                "unattributed_http",
                "stdio",
                "other"
              ],
              "properties": {
                "attributed": {
                  "type": "integer",
                  "minimum": 0
                },
                "unattributed_http": {
                  "type": "integer",
                  "minimum": 0
                },
                "stdio": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Declarations whose transport is stdio, as scan_mcp states it."
                },
                "ambiguous": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "HTTP declarations whose origin two agents claim; attributed to neither."
                },
                "other": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Neither stdio nor an HTTP(S) origin: ws://, a malformed target, no target."
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "carried": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "reason"
        ],
        "properties": {
          "source": {
            "enum": [
              "fabric-services",
              "fabric-manifest",
              "launchd",
              "mcp-inventory"
            ]
          },
          "reason": {
            "type": "string"
          },
          "agent": {
            "$ref": "#/$defs/agentId"
          }
        },
        "additionalProperties": false
      }
    },
    "source_refs": {
      "type": "array",
      "contains": {
        "const": "SRC-0020"
      },
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{4}$"
      }
    },
    "stale": {
      "type": "boolean",
      "description": "true: the collector's scan is older than one tick; nothing is dated after it."
    }
  },
  "patternProperties": {
    "^_": true
  },
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^agent:([a-z][a-z0-9-]{1,62}\\.[a-z][a-z0-9-]{0,31}|file:[A-Za-z0-9._-]{1,160})$"
    },
    "supervisorState": {
      "enum": [
        "running",
        "loaded",
        "not-loaded",
        "not-measured",
        "platform",
        "unsupervised"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "service_id",
        "instance",
        "name",
        "placement",
        "origin",
        "host",
        "port",
        "protocol",
        "descriptor",
        "key_in_url",
        "commands",
        "supervisor",
        "manifest",
        "valid",
        "problems",
        "carried",
        "first_seen_on",
        "last_seen_running_on",
        "mcp_declarations",
        "source_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/agentId"
        },
        "service_id": {
          "$ref": "#/$defs/nullableString"
        },
        "instance": {
          "$ref": "#/$defs/nullableString"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "placement": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "origin": {
          "$ref": "#/$defs/nullableString"
        },
        "host": {
          "$ref": "#/$defs/nullableString"
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "$ref": "#/$defs/nullableString"
        },
        "descriptor": {
          "type": "string",
          "description": "The descriptor's file name in the services directory.",
          "maxLength": 160
        },
        "installed_at": {
          "$ref": "#/$defs/nullableString"
        },
        "source_repository": {
          "$ref": "#/$defs/nullableString"
        },
        "commands": {
          "type": "array",
          "items": {
            "enum": [
              "doctor",
              "update"
            ]
          }
        },
        "supervisor": {
          "type": "object",
          "required": [
            "manager",
            "state"
          ],
          "properties": {
            "manager": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            },
            "label": {
              "type": "string",
              "maxLength": 300
            },
            "unit": {
              "type": "string",
              "maxLength": 300
            },
            "task": {
              "type": "string",
              "maxLength": 300
            },
            "plist": {
              "type": "string",
              "maxLength": 300
            },
            "plist_present": {
              "type": "boolean"
            },
            "state": {
              "$ref": "#/$defs/supervisorState"
            },
            "last_exit_status": {
              "type": "integer"
            },
            "why": {
              "type": "string",
              "maxLength": 300
            }
          },
          "additionalProperties": false
        },
        "manifest": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "pinned",
                "absent",
                "unreadable"
              ]
            },
            "path": {
              "type": "string",
              "maxLength": 300
            },
            "contract_version": {
              "type": "string",
              "maxLength": 300
            },
            "provider_id": {
              "type": "string",
              "maxLength": 300
            },
            "provider_revision": {
              "type": "integer"
            },
            "content_hash": {
              "type": "string",
              "maxLength": 300
            },
            "supported_contract_versions": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          "additionalProperties": false
        },
        "valid": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "maxItems": 21,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "carried": {
          "type": "boolean",
          "description": "true: the services directory could not be read this time and the row is the previous document's."
        },
        "first_seen_on": {
          "$ref": "#/$defs/date"
        },
        "last_seen_running_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcp_declarations": {
          "description": "Ids from registry/mcp-servers.json whose target is this agent's origin; null when no MCP inventory was read.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^mcp:"
              }
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-[0-9]{4}$"
          }
        },
        "key_in_url": {
          "type": "boolean",
          "description": "The descriptor's origin or source repository carried user-info or a query; it was dropped."
        },
        "carried_since": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": false
    }
  }
}
