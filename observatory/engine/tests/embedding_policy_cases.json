{
  "contract": "embedding-policy/1",
  "about": "Accepted decision fixtures for PB-137 N-002. Each case is one decision the enforcement (N-003) must reproduce. Synthetic project ids; no credential, no real text.",
  "configured": {
    "provider": "openai",
    "model": "text-embedding-3-small"
  },
  "policies": {
    "consented": {
      "schema": "embedding-policy/1",
      "policyRevision": 3,
      "projects": {
        "project:alpha": {
          "remote": {
            "provider": "openai",
            "model": "text-embedding-3-small",
            "classes": [
              "public",
              "project-internal"
            ],
            "consent": {
              "statement": "Texts of project alpha are sent to OpenAI to compute embeddings.",
              "by": "operator",
              "at": "2026-10-04T10:00:00Z",
              "via": "terminal"
            },
            "revokedAt": null
          }
        },
        "project:beta": {
          "remote": {
            "provider": "openai",
            "model": "text-embedding-3-small",
            "classes": [
              "public"
            ],
            "consent": {
              "statement": "Public texts of project beta are sent to OpenAI for embeddings.",
              "by": "operator",
              "at": "2026-10-04T10:00:00Z",
              "via": "terminal"
            },
            "revokedAt": null
          }
        },
        "project:gamma": {
          "remote": {
            "provider": "openai",
            "model": "text-embedding-3-small",
            "classes": [
              "public",
              "project-internal"
            ],
            "consent": {
              "statement": "Texts of project gamma are sent to OpenAI for embeddings.",
              "by": "operator",
              "at": "2026-09-30T10:00:00Z",
              "via": "terminal"
            },
            "revokedAt": "2026-10-03T09:00:00Z"
          }
        }
      }
    }
  },
  "records": [
    {
      "name": "consented project-internal record goes remote",
      "policy": "consented",
      "record": {
        "project_id": "project:alpha",
        "classification": "project-internal",
        "scope": "project",
        "kind": "note"
      },
      "expect": {
        "route": "remote",
        "reason": "remote-consented"
      }
    },
    {
      "name": "consented public record goes remote",
      "policy": "consented",
      "record": {
        "project_id": "project:alpha",
        "classification": "public",
        "scope": "run",
        "kind": "note"
      },
      "expect": {
        "route": "remote",
        "reason": "remote-consented"
      }
    },
    {
