        "scope": "memory.checkpoint",
        "projectId": "project:alpha",
        "workflowId": "wf_fedcba9876543210",
        "effect": "propose"
      },
      "expect": {
        "allow": false,
        "reason": "workflow-not-bound"
      }
    },
    {
      "name": "a workflow-bound session must name its workflow",
      "binding": "bnd_session01",
      "request": {
        "scope": "memory.handoff",
        "projectId": "project:alpha",
        "effect": "propose"
      },
      "expect": {
        "allow": false,
        "reason": "workflow-required"
      }
    },
    {
      "name": "an unknown scope is denied",
      "binding": "bnd_session01",
      "request": {
        "scope": "memory.forget",
        "projectId": "project:alpha",
        "workflowId": "wf_0123456789abcdef",
        "effect": "propose"
      },
      "expect": {
        "allow": false,
        "reason": "scope-not-bound"
      }
    },
    {
      "name": "no binding, no access",
      "binding": null,
      "request": {
        "scope": "memory.read",
        "projectId": "project:alpha",
        "effect": "read"
      },
      "expect": {
        "allow": false,
        "reason": "no-binding"
      }
    },
    {
      "name": "a caller-supplied owner argument changes nothing",
      "binding": "bnd_partner01",
      "request": {
        "scope": "memory.read",
        "projectId": "project:beta",
        "effect": "read",
        "owner": "operator",
        "principal": "local:stdio"
      },
      "expect": {
        "allow": false,
        "reason": "project-not-bound"
      }
    },
    {
      "name": "a read-only binding cannot write even with the scope listed",
      "binding": "bnd_reader01",
      "request": {
        "scope": "memory.record",
        "projectId": "project:alpha",
        "effect": "propose"
      },
      "expect": {
        "allow": false,
        "reason": "effect-above-ceiling"
      }
    },
    {
      "name": "a read-only binding reads",
      "binding": "bnd_reader01",
      "request": {
        "scope": "memory.read",
        "projectId": "project:alpha",
        "effect": "read"
      },
      "expect": {
        "allow": true,
        "reason": "allowed"
      }
    }
