  "authorize": [
    {
      "name": "the local agent reads any project",
      "binding": "local:stdio",
      "request": {
        "scope": "memory.read",
        "projectId": "project:zeta",
        "effect": "read"
      },
      "expect": {
        "allow": true,
        "reason": "allowed"
      }
    },
    {
      "name": "the local agent records a proposal",
      "binding": "local:stdio",
      "request": {
        "scope": "memory.record",
        "projectId": "project:zeta",
        "effect": "propose"
      },
      "expect": {
        "allow": true,
        "reason": "allowed"
      }
    },
    {
      "name": "the local agent cannot act with the operator's authority",
      "binding": "local:stdio",
      "request": {
        "scope": "memory.record",
        "projectId": "project:zeta",
        "effect": "operator"
      },
      "expect": {
        "allow": false,
        "reason": "effect-above-ceiling"
      }
    },
    {
      "name": "a partner reads its project",
      "binding": "bnd_partner01",
      "request": {
        "scope": "memory.search",
        "projectId": "project:alpha",
        "effect": "read"
      },
      "expect": {
        "allow": true,
        "reason": "allowed"
      }
    },
    {
      "name": "a partner cannot read another project",
