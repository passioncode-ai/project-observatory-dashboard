{
 "_why": "What tools/cleanup.py may remove, and after how long. AUTO classes lose nothing — merged commits live on the default branch, pushed ones on the remote, build output is regenerated — and run on every tick and from the disk guard when `features.auto_cleanup` is true (the guard lowers their idle thresholds by disk pressure, `pressure`). MANUAL classes hold the only copy of somebody's work; `full cleanup --apply` archives them first (bundle, patch, tarball), and never on a tick. A name matching `protect` is never touched.",
 "max_actions_per_run": 200,
 "protect": ["keep/*", "release/*", "hotfix/*", "develop", "staging", "production"],
 "auto": {
  "merged_branch_idle_days": 7,
  "pushed_branch_idle_days": 30,
  "clean_worktree_idle_days": 7,
  "build_artifacts_project_idle_days": 30
 },
 "pressure": {
  "low": {"merged_branch_idle_days": 3, "pushed_branch_idle_days": 14, "clean_worktree_idle_days": 3, "build_artifacts_project_idle_days": 7},
  "critical": {"merged_branch_idle_days": 1, "pushed_branch_idle_days": 7, "clean_worktree_idle_days": 1, "build_artifacts_project_idle_days": 3}
 },
 "manual": {
  "unique_branch_idle_days": 14,
  "dirty_worktree_idle_days": 7
 },
 "artifact_dirs": ["node_modules", ".next", ".turbo", ".nuxt", ".svelte-kit", ".parcel-cache", ".expo",
                   "target", "DerivedData", "Pods", ".gradle", "build", "dist", ".output", ".wrangler",
                   "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache"],
 "guard": {
  "_why": "tools/disk_guard.py, run by the maintenance job (every 15 minutes; hourly while space is normal, every pass below `low`) before the backup. Free space below levels.low / levels.critical (GB) moves every threshold below it. It removes only what nobody holds open, maps, runs from or works inside (a fresh listing per class, re-checked at each removal), never a privacy-guarded place, never a symlink target, never another user's file; it stops no process. Every action is journalled with the free-space delta the disk reports.",
  "levels": {"low": {"free_gb": 25}, "critical": {"free_gb": 10}},
  "temp_days": {"normal": 3, "low": 1, "critical": 1},
  "build_idle_days": {"normal": 14, "low": 3, "critical": 1},
  "trash_days": {"normal": 30, "low": 30, "critical": 3},
  "clone_min_age_hours": 1,
  "temp_roots": [
   {"path": "{tmpdir}", "depth": 1},
   {"path": "/private/tmp", "depth": 1},
   {"path": "/private/tmp/claude-{uid}", "depth": 2},
   {"path": "{tmpdir}/pytest-of-{user}", "depth": 1, "hours": {"normal": 24, "low": 6, "critical": 2}},
   {"path": "~/Library/Developer/Xcode/DerivedData", "depth": 1, "level": "low"},
  {"path": "~/Library/Logs/DiagnosticReports", "depth": 1, "level": "low"}
  ],
  "temp_keep": ["cc-socks", "*.sock", "*.socket", "tmux-*", "com.apple.*", "launchd*", "powerlog", ".X*", "*.pid", "*.lock"],
  "commands": [
   {"argv": ["uv", "cache", "prune"], "level": "normal", "busy_output": "in-use", "why": "uv: entries no environment uses (it takes uv's own lock)"},
   {"argv": ["pnpm", "store", "prune"], "level": "normal", "busy_if": ["pnpm"], "why": "pnpm: packages no project references"},
   {"argv": ["brew", "cleanup", "--prune=14"], "level": "normal", "busy_if": ["brew"], "why": "Homebrew: old versions and downloads older than 14 days"},
   {"argv": ["docker", "builder", "prune", "-f", "--filter", "until=168h"], "level": "normal", "needs_running": ["OrbStack", "OrbStack Helper", "com.docker.backend", "dockerd"], "why": "Docker: build cache unused for a week (only while the daemon already runs)"},
   {"argv": ["npm", "cache", "verify"], "level": "low", "why": "npm: garbage-collects the cache; safe beside a running npm"},
   {"argv": ["uv", "cache", "clean"], "level": "low", "busy_if": ["uv"], "busy_output": "in-use", "every_hours": 24, "why": "uv: the whole cache, re-downloaded on demand"},
   {"argv": ["go", "clean", "-cache"], "level": "low", "busy_if": ["go"], "why": "Go: the build cache"},
   {"argv": ["yarn", "cache", "clean"], "level": "low", "busy_if": ["yarn"], "why": "Yarn: the package cache"},
   {"argv": ["docker", "image", "prune", "-f"], "level": "low", "needs_running": ["OrbStack", "OrbStack Helper", "com.docker.backend", "dockerd"], "why": "Docker: dangling images only"},
   {"argv": ["brew", "cleanup", "--prune=all", "-s"], "level": "critical", "busy_if": ["brew"], "every_hours": 24, "why": "Homebrew: every cached download"}
  ],
  "large_file_min_mb": 1024,
  "large_files_every_hours": 24,
  "large_files_budget_seconds": 120,
  "large_files_top": 30,
  "large_files_skip": ["node_modules", ".Trash", "OrbStack"],
  "git_survey_every_hours": 6,
  "machine_survey_every_hours": 2,
  "plan_budget_seconds": 300,
  "normal_every_minutes": 60,
  "due_tolerance_seconds": 450,
  "command_every_hours": 6,
  "command_timeout_seconds": 90,
  "cache_roots": ["~/Library/Caches", "~/.cache", "~/.npm/_npx", "{localappdata}/npm-cache/_npx"],
  "cache_days": {"normal": 7, "low": 2, "critical": 1},
  "cache_keep": ["ms-playwright", "ms-playwright-go", "camoufox", "puppeteer", "hyperframes", "chrome-for-testing", "cargo-xwin", "codex-runtimes", "uv", "pnpm", "Homebrew", "com.apple.*", "CloudKit", "observatory*", "agent-chrome", "huggingface", "torch", "whisper*", "*-models"],
  "run_budget_seconds": 900,
  "git_tier_seconds": 120,
  "run_reserve_seconds": 60,
  "max_actions_per_class": 20000
 }
}
