{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/service-well-known.schema.json",
  "title": "Local service well-known document (fabric-service/0.1)",
  "type": "object",
  "required": [
    "protocol",
    "service",
    "process",
    "status",
    "degraded",
    "surfaces"
  ],
  "properties": {
    "protocol": {
      "$ref": "service-common.schema.json#/$defs/protocol"
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "instance",
        "name",
        "version",
        "build"
      ],
      "properties": {
        "id": {
          "$ref": "service-common.schema.json#/$defs/serviceId"
        },
        "instance": {
          "$ref": "service-common.schema.json#/$defs/instance"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "build": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "dirty": {
              "type": "boolean"
            },
            "builtAt": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          },
          "anyOf": [
            {
              "required": [
                "commit"
              ],
              "properties": {
                "commit": true
              }
            },
            {
              "required": [
                "digest"
              ],
              "properties": {
                "digest": true
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "required": [
        "pid",
        "startedAt"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "startedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "starting",
        "ready",
        "degraded",
        "stopping"
      ]
    },
    "degraded": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "source",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 40
              }
            ]
          },
          "attention": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "dashboard": {
          "type": "object",
          "required": [
            "path",
            "login"
          ],
          "properties": {
            "path": {
              "$ref": "service-common.schema.json#/$defs/originPath"
            },
            "login": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "required": [
            "path",
            "transport"
          ],
          "properties": {
            "path": {
              "$ref": "service-common.schema.json#/$defs/originPath"
            },
            "transport": {
              "const": "streamable-http"
            },
            "capabilities": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/capabilityName"
              }
            },
            "auth": {
              "description": "DEC-0024, DEC-0039. descriptor (default): the MCP surface takes the descriptor's token in its header. own: it authenticates its callers with credentials of its own (a token per agent, a gateway's caller identity); the descriptor's token is the host's and is not an MCP credential. delegation: it takes only the estate's delegation tokens (auth.delegation), and the descriptor's token is not an MCP credential.",
              "enum": [
                "descriptor",
                "own",
                "delegation"
              ]
            }
          },
          "additionalProperties": false
        },
        "events": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "service-common.schema.json#/$defs/originPath"
            },
            "stream": {
              "$ref": "service-common.schema.json#/$defs/originPath"
            }
          },
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "service-common.schema.json#/$defs/originPath"
            }
          },
          "additionalProperties": false
        },
        "operatorChannel": {
          "description": "DEC-0034. Where the service answers its operator-channel status (fabric-operator-channel/0.1); token-protected like the events feed.",
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "service-common.schema.json#/$defs/originPath"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "description": "DEC-0039. How the service authenticates calls beyond the descriptor's token.",
      "type": "object",
      "properties": {
        "delegation": {
          "description": "The service accepts the estate's delegation tokens (fabric-delegation/0.1): Authorization: Bearer on a direct call, Fabric-Delegation on a call the hub forwards.",
          "type": "object",
          "required": [
            "issuer",
            "jwks"
          ],
          "properties": {
            "issuer": {
              "$ref": "common.schema.json#/$defs/uri",
              "description": "The iss it trusts: the estate hub."
            },
            "jwks": {
              "$ref": "common.schema.json#/$defs/uri",
              "description": "Where it reads the estate's public keys (the hub's /.well-known/jwks.json, or the copy Fabric publishes)."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "surfaces"
        ],
        "properties": {
          "surfaces": {
            "type": "object",
            "required": [
              "mcp"
            ],
            "properties": {
              "mcp": {
                "type": "object",
                "required": [
                  "auth"
                ],
                "properties": {
                  "auth": {
                    "const": "delegation"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "auth"
        ],
        "properties": {
          "auth": {
            "type": "object",
            "required": [
              "delegation"
            ],
            "properties": {
              "delegation": true
            }
          }
        }
      }
    }
  ]
}
