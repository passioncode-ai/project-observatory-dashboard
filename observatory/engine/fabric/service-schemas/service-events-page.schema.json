{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/service-events-page.schema.json",
  "title": "Local service events page (fabric-service/0.1)",
  "type": "object",
  "required": [
    "events",
    "cursor"
  ],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "cursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "at",
        "kind",
        "level",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,5}$"
        },
        "level": {
          "enum": [
            "info",
            "notice",
            "warning",
            "error"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "data": {
          "type": "object",
          "required": [
            "schema",
            "value"
          ],
          "additionalProperties": false,
          "description": "DEC-0070: optional machine-readable fields of the event. A host that ignores it loses nothing: text stays the sentence a person reads. Never a secret or personal data (FAC-SEM-101 refuses a credential-shaped value or name). A host validates value against schema when it knows that schema, and otherwise treats value as opaque and never fails the event for it.",
          "properties": {
            "schema": {
              "$ref": "common.schema.json#/$defs/uri",
              "description": "An absolute URI of the payload schema the service publishes (under its origin or its repository)."
            },
            "value": {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": {
                "$ref": "#/$defs/dataValue"
              }
            }
          }
        },
        "subject": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "label": {
              "type": "string",
              "maxLength": 120
            }
          },
          "additionalProperties": false
        },
        "link": {
          "$ref": "service-common.schema.json#/$defs/originPath"
        },
        "notify": {
          "type": "boolean"
        },
        "traceId": {
          "$ref": "common.schema.json#/$defs/traceId"
        },
        "spanId": {
          "$ref": "common.schema.json#/$defs/spanId"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "traceId": [
          "spanId"
        ],
        "spanId": [
          "traceId"
        ]
      }
    },
    "dataScalar": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/dataScalar"
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/dataScalar"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/dataScalar"
          }
        }
      ],
      "description": "A scalar, a list of at most 32 scalars, or an object of at most 32 scalar members: two levels at most."
    }
  }
}
