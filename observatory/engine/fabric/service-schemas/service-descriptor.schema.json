{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/service-descriptor.schema.json",
  "title": "Local service descriptor (fabric-service/0.1)",
  "type": "object",
  "required": [
    "protocol",
    "id",
    "instance",
    "name",
    "origin",
    "auth",
    "lifecycle",
    "paths",
    "installedAt",
    "installedBy"
  ],
  "properties": {
    "protocol": {
      "$ref": "service-common.schema.json#/$defs/protocol"
    },
    "id": {
      "$ref": "service-common.schema.json#/$defs/serviceId"
    },
    "instance": {
      "$ref": "service-common.schema.json#/$defs/instance"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "origin": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:([1-9][0-9]{2,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "auth": {
      "type": "object",
      "required": [
        "tokenFile"
      ],
      "properties": {
        "tokenFile": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "header": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
          "default": "Authorization"
        },
        "scheme": {
          "enum": [
            "Bearer",
            "none"
          ],
          "default": "Bearer"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "header"
            ],
            "properties": {
              "header": {
                "not": {
                  "const": "Authorization"
                }
              }
            }
          },
          "then": {
            "required": [
              "scheme"
            ],
            "properties": {
              "scheme": {
                "const": "none"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "manager"
      ],
      "properties": {
        "manager": {
          "enum": [
            "launchd",
            "none"
          ]
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,254}$"
        },
        "plist": {
          "allOf": [
            {
              "$ref": "service-common.schema.json#/$defs/localPath"
            },
            {
              "type": "string",
              "pattern": "\\.plist$"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "manager": {
            "const": "launchd"
          }
        }
      },
      "then": {
        "required": [
          "label",
          "plist"
        ],
        "properties": {
          "label": true,
          "plist": true
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "required": [
        "data",
        "logs"
      ],
      "properties": {
        "data": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "config": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "cache": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "logs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "service-common.schema.json#/$defs/localPath"
          }
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "doctor": {
          "$ref": "service-common.schema.json#/$defs/argv"
        },
        "update": {
          "$ref": "service-common.schema.json#/$defs/argv"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "common.schema.json#/$defs/uri"
        }
      },
      "additionalProperties": false
    },
    "fabricManifest": {
      "$ref": "service-common.schema.json#/$defs/localPath"
    },
    "installedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "installedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
