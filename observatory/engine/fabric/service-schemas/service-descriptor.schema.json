{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/service-descriptor.schema.json",
  "title": "Service descriptor (fabric-service/0.1)",
  "type": "object",
  "required": [
    "protocol",
    "id",
    "instance",
    "name",
    "origin",
    "auth",
    "lifecycle",
    "installedAt",
    "installedBy"
  ],
  "properties": {
    "protocol": {
      "$ref": "service-common.schema.json#/$defs/protocol"
    },
    "id": {
      "$ref": "service-common.schema.json#/$defs/serviceId"
    },
    "instance": {
      "$ref": "service-common.schema.json#/$defs/instance"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "placement": {
      "enum": [
        "local",
        "remote"
      ],
      "default": "local",
      "description": "local: a process on this computer at http://127.0.0.1:<port>, supervised by launchd or by nothing. remote: an online agent or dashboard at an https origin, supervised by its platform (DEC-0019)."
    },
    "origin": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^http://127\\.0\\.0\\.1:([1-9][0-9]{2,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        {
          "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
          "type": "string"
        }
      ],
      "description": "local: http://127.0.0.1:<port>. remote: https://<dns-name>[:<port>] with no path, query or userinfo; an IP literal is never a remote origin."
    },
    "auth": {
      "type": "object",
      "required": [
        "tokenFile"
      ],
      "properties": {
        "tokenFile": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "header": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
          "default": "Authorization"
        },
        "scheme": {
          "enum": [
            "Bearer",
            "none"
          ],
          "default": "Bearer"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "header"
            ],
            "properties": {
              "header": {
                "not": {
                  "const": "Authorization"
                }
              }
            }
          },
          "then": {
            "required": [
              "scheme"
            ],
            "properties": {
              "scheme": {
                "const": "none"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "manager"
      ],
      "properties": {
        "manager": {
          "enum": [
            "launchd",
            "systemd",
            "task-scheduler",
            "none"
          ]
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,254}$"
        },
        "plist": {
          "allOf": [
            {
              "$ref": "service-common.schema.json#/$defs/localPath"
            },
            {
              "type": "string",
              "pattern": "\\.plist$"
            }
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.@-]{0,250}\\.service$",
          "description": "DEC-0032: the systemd user unit (`systemctl --user`) that supervises this service on Linux."
        },
        "task": {
          "type": "string",
          "pattern": "^\\\\[A-Za-z0-9 ._\\\\-]{1,254}$",
          "description": "DEC-0032: the per-user Scheduled Task (full path, e.g. `\\\\PassionCode\\\\example-agent.default`) that supervises this service on Windows."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "manager": {
                "const": "launchd"
              }
            }
          },
          "then": {
            "required": [
              "label",
              "plist"
            ],
            "properties": {
              "label": true,
              "plist": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "manager": {
                "const": "systemd"
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "unit": true
            }
          },
          "else": {
            "not": {
              "required": [
                "unit"
              ],
              "properties": {
                "unit": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "manager": {
                "const": "task-scheduler"
              }
            }
          },
          "then": {
            "required": [
              "task"
            ],
            "properties": {
              "task": true
            }
          },
          "else": {
            "not": {
              "required": [
                "task"
              ],
              "properties": {
                "task": true
              }
            }
          }
        }
      ]
    },
    "paths": {
      "type": "object",
      "required": [
        "data",
        "logs"
      ],
      "properties": {
        "data": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "config": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "cache": {
          "$ref": "service-common.schema.json#/$defs/localPath"
        },
        "logs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "service-common.schema.json#/$defs/localPath"
          }
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "doctor": {
          "$ref": "service-common.schema.json#/$defs/argv"
        },
        "update": {
          "$ref": "service-common.schema.json#/$defs/argv"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "common.schema.json#/$defs/uri"
        }
      },
      "additionalProperties": false
    },
    "fabricManifest": {
      "$ref": "service-common.schema.json#/$defs/localPath"
    },
    "installedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "installedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "placement": {
            "const": "remote",
            "type": "string"
          }
        },
        "required": [
          "placement"
        ]
      },
      "then": {
        "properties": {
          "origin": {
            "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
            "type": "string"
          },
          "lifecycle": {
            "properties": {
              "manager": {
                "const": "none"
              }
            },
            "type": "object"
          },
          "commands": {
            "properties": {
              "update": false
            },
            "type": "object"
          }
        }
      },
      "else": {
        "required": [
          "paths"
        ],
        "properties": {
          "origin": {
            "pattern": "^http://127\\.0\\.0\\.1:([1-9][0-9]{2,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "type": "string"
          },
          "paths": true
        }
      }
    }
  ]
}
