{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/service-common.schema.json",
  "title": "Local service extension common definitions",
  "$defs": {
    "protocol": {
      "const": "fabric-service/0.1"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "localPath": {
      "type": "string",
      "pattern": "^(~/|/)[^\\u0000]*$",
      "maxLength": 1024
    },
    "originPath": {
      "type": "string",
      "pattern": "^/(?!/)[^\\s]*$",
      "maxLength": 2048
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
