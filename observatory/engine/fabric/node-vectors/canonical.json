  "differ": [
    {
      "name": "the audit probe (F-B-315): separators and key order",
      "input": {
        "b": 1,
        "a": [
          "x",
          true
        ],
        "\ud83d\ude00": 1,
        "\uff61": 2
      },
      "settings": "{\"a\": [\"x\", true], \"b\": 1, \"\uff61\": 2, \"\ud83d\ude00\": 1}",
      "rfc8785": "{\"a\":[\"x\",true],\"b\":1,\"\ud83d\ude00\":1,\"\uff61\":2}"
    },
    {
      "name": "a fraction: RFC 8785 writes it, the settings form refuses it",
      "inputJson": "{\"price\": 0.5}",
      "settings": null,
      "rfc8785": "{\"price\":0.5}"
    }
  ],
