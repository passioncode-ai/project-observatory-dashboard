{
  "$comment": "Shared vectors of the contract's two canonical JSON forms (DEC-0043, docs/specification/conformance.md#canonical-forms). A kit port runs its own functions over them. `inputJson` is JSON text to parse where the text matters (RFC samples, -0, a lone surrogate); otherwise `input` is the value. `ieee754` is the big-endian hex of a double. Settings-form outputs were written by Python's json.dumps(value, sort_keys=True, ensure_ascii=False); RFC 8785 outputs are the RFC's own (text pinned in docs/evidence/sources.md) or written by a UTF-16 code-unit sort over integers and strings.",
  "settings": {
    "function": "settingsCanonicalJson (src/canonical.ts)",
    "vectors": [
      {
        "name": "separators, null, literals, escaping",
        "input": {
          "b": [
            1,
            "\u00e9\n\"x\"",
            true
          ],
          "a": null,
          "c": {}
        },
        "expected": "{\"a\": null, \"b\": [1, \"\u00e9\\n\\\"x\\\"\", true], \"c\": {}}"
      },
      {
        "name": "code-point key order above U+FFFF",
        "note": "U+FF61 < U+FFFF < U+1F600 by code point; UTF-16 order would put U+1F600 (D83D DE00) before U+FFFF",
        "input": {
          "\ud83d\ude00": 1,
          "\uffff": 2,
          "\uff61": 3
        },
        "expected": "{\"\uff61\": 3, \"\uffff\": 2, \"\ud83d\ude00\": 1}"
      },
      {
        "name": "RFC 8785 \u00a73.2.3 sorting sample, in code-point order",
        "note": "the emoji sorts last here and before U+FB33 in RFC 8785",
        "inputJson": "{\n  \"\\u20ac\": \"Euro Sign\",\n  \"\\r\": \"Carriage Return\",\n  \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n  \"1\": \"One\",\n  \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n  \"\\u0080\": \"Control\",\n  \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n}",
        "expected": "{\"\\r\": \"Carriage Return\", \"1\": \"One\", \"\u0080\": \"Control\", \"\u00f6\": \"Latin Small Letter O With Diaeresis\", \"\u20ac\": \"Euro Sign\", \"\ufb33\": \"Hebrew Letter Dalet With Dagesh\", \"\ud83d\ude00\": \"Emoji: Grinning Face\"}"
      },
      {
        "name": "nesting, control characters, empty key",
        "input": {
          "z": {
            "y": [
              {
                "b": 0,
                "a": -1
              }
            ]
          },
          "ctl": "\u0000\u001f\u007f\t\u2028",
          "": []
        },
        "expected": "{\"\": [], \"ctl\": \"\\u0000\\u001f\u007f\\t\u2028\", \"z\": {\"y\": [{\"a\": -1, \"b\": 0}]}}"
      },
      {
        "name": "integer bounds and minus zero",
        "inputJson": "[9007199254740991, -9007199254740991, 0, -0]",
        "expected": "[9007199254740991, -9007199254740991, 0, 0]"
      }
    ],
    "refuses": [
      {
        "name": "a fraction",
        "inputJson": "{\"price\": 0.5}"
      },
      {
        "name": "an integer above 2^53 - 1",
        "inputJson": "[9007199254740992]"
      },
      {
        "name": "an integer below -(2^53 - 1)",
        "inputJson": "[-9007199254740992]"
      },
      {
        "name": "an exponent form that is not an integer",
        "inputJson": "1e-7"
      },
      {
        "name": "a lone surrogate (CT-25, DEC-0052)",
        "inputJson": "\"\\ud800\""
      },
      {
        "name": "a lone surrogate in a key (CT-25, DEC-0052)",
        "inputJson": "{\"\\udc00\": 1}"
      },
      {
        "name": "a lone low surrogate after a pair",
        "inputJson": "[\"\\ud83d\\ude00\\ude00\"]"
      }
    ]
  },
  "rfc8785": {
    "function": "rfc8785 (src/canonical.ts)",
    "vectors": [
      {
        "name": "RFC 8785 \u00a73.2.2 sample, canonicalised as \u00a73.2.3 prints it",
        "note": "utf8Hex is \u00a73.2.4",
        "inputJson": "{\n  \"numbers\": [333333333.33333329, 1E30, 4.50,\n              2e-3, 0.000000000000000000000000001],\n  \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n  \"literals\": [null, true, false]\n}",
        "expected": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"\u20ac$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
        "utf8Hex": "7b226c69746572616c73223a5b6e756c6c2c747275652c66616c73655d2c226e756d62657273223a5b3333333333333333332e333333333333332c31652b33302c342e352c302e3030322c31652d32375d2c22737472696e67223a22e282ac245c75303030665c6e4127425c225c5c5c5c5c222f227d"
      },
      {
        "name": "RFC 8785 \u00a73.2.3 sorting sample: UTF-16 code-unit order",
        "note": "argument order: Carriage Return, One, Control, Latin Small Letter O With Diaeresis, Euro Sign, Emoji: Grinning Face, Hebrew Letter Dalet With Dagesh",
        "inputJson": "{\n  \"\\u20ac\": \"Euro Sign\",\n  \"\\r\": \"Carriage Return\",\n  \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n  \"1\": \"One\",\n  \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n  \"\\u0080\": \"Control\",\n  \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n}",
        "expected": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"}"
      },
      {
        "name": "UTF-16 key order above U+FFFF",
        "note": "U+FF61 < U+1F600 (D83D DE00) < U+FFFF by UTF-16 code unit",
        "input": {
          "\ud83d\ude00": 1,
          "\uffff": 2,
          "\uff61": 3
        },
        "expected": "{\"\ud83d\ude00\":1,\"\uff61\":3,\"\uffff\":2}"
      },
      {
        "name": "nesting, control characters, empty key",
        "input": {
          "z": {
            "y": [
              {
                "b": 0,
                "a": -1
              }
            ]
          },
          "ctl": "\u0000\u001f\u007f\t\u2028",
          "": []
        },
        "expected": "{\"\":[],\"ctl\":\"\\u0000\\u001f\u007f\\t\u2028\",\"z\":{\"y\":[{\"a\":-1,\"b\":0}]}}"
      },
      {
        "name": "minus zero",
        "inputJson": "[-0]",
        "expected": "[0]"
      }
    ],
    "numbers": [
      {
