{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/peer-share-report.schema.json",
  "title": "A shared credential's usage report, fabric-peer-share-report/1 (DEC-0142)",
  "description": "The recipient's usage report for one share: the body (#/$defs/body) sealed with HPKE base mode, suite [16, 1, 1], to the sender's share #kem, info the ASCII fabric-peer-share-report/1, the RFC 8785 bytes of the header the additional data; signed ES256 by the recipient's share #sig. A sequence that does not advance is replayed (checkPeerReport). docs/specification/peer-share.md#usage-reports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "ct",
    "sig"
  ],
  "properties": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "alg",
        "suite",
        "recipient",
        "signer",
        "shareId",
        "sequence",
        "iat",
        "enc"
      ],
      "properties": {
        "type": {
          "const": "fabric-peer-share-report/1"
        },
        "alg": {
          "type": "string",
          "maxLength": 16,
          "description": "ES256; another is unsupported-alg"
        },
        "suite": {
          "type": "array",
          "prefixItems": [
            {
              "const": 16
            },
            {
              "const": 1
            },
            {
              "const": 1
            }
          ],
          "items": false,
          "minItems": 3
        },
        "recipient": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "The RFC 7638 thumbprint of the sender's share #kem."
        },
        "signer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "The RFC 7638 thumbprint of the recipient's share #sig."
        },
        "shareId": {
          "$ref": "peer-share-frame.schema.json#/$defs/shareId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "iat": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "description": "An RFC 3339 instant in UTC, ending in Z, as the relay family reads it."
        },
        "enc": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "The HPKE encapsulated key, unpadded base64url."
        }
      }
    },
    "ct": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "description": "ES256 over the RFC 8785 bytes of {header, ct}, raw r || s, low-S, unpadded base64url."
    }
  },
  "$defs": {
    "body": {
      "type": "object",
      "required": [
        "days",
        "consumers",
        "exports"
      ],
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": [
              "date",
              "slot",
              "uses",
              "lastUse"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "slot": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "uses": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastUse": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
                    "description": "An RFC 3339 instant in UTC, ending in Z, as the relay family reads it."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "description": "Per slot and UTC day: the uses the recipient's node counted, and the last one."
        },
        "consumers": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": [
              "slot",
              "agent"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "agent": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:@/-]{0,127}$",
                "description": "A consumer label: an agent's name from the node's journal."
              }
            }
          }
        },
        "exports": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": [
              "slot",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
                "description": "An RFC 3339 instant in UTC, ending in Z, as the relay family reads it."
              }
            }
          },
          "description": "Exports made with the export button, recorded before the value left; not every way a value can leave."
        }
      },
      "description": "The report's plaintext (peerReportBody): counts, consumer labels and the time of each day's last use and of each export, never a value, a command, an argument or an output (DEC-0111's call-record rule)."
    }
  }
}
