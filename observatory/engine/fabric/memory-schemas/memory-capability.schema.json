{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/memory-capability.schema.json",
  "title": "memory/0.1 — agent memory capabilities (DEC-0023)",
  "description": "The wire of agent memory: a provider declaration, a call and an answer for each capability. Shapes are taken from Project Observatory's served tools (the first provider, Fabric ADR-0105). Inputs refuse unknown fields; outputs require their core fields and may carry more.",
  "oneOf": [
    {
      "$ref": "#/$defs/declaration"
    },
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/answer"
    }
  ],
  "$defs": {
    "capability": {
      "enum": [
        "memory.checkpoint.write",
        "memory.checkpoint.latest",
        "memory.handoff.create",
        "memory.handoff.accept",
        "memory.handoff.get",
        "memory.workflow.list",
        "memory.record",
        "memory.search",
        "memory.recall"
      ]
    },
    "reservedCapability": {
      "enum": [
        "memory.learning.propose",
        "memory.explain",
        "memory.forget"
      ],
      "description": "Named by memory/0.1 for a later revision; a provider must not serve them under these names before their schema exists."
    },
    "declaration": {
      "type": "object",
      "required": [
        "kind",
        "family",
        "provider",
        "capabilities",
        "compatibility"
      ],
      "properties": {
        "kind": {
          "const": "memory-provider"
        },
        "family": {
          "const": "memory/0.1"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "description": "memory/0.1 has no optional capability: a provider serves all nine."
        },
        "compatibility": {
          "type": "object",
          "description": "Each capability's existing tool name at this provider, so a client of the provider's own tools and a memory/0.1 client reach the same code.",
          "propertyNames": {
            "$ref": "#/$defs/capability"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,63}$"
          }
        }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": [
        "kind",
        "capability",
        "input"
      ],
      "properties": {
        "kind": {
          "const": "memory-call"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "input": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.checkpoint.write"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.checkpoint.write"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.checkpoint.latest"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.checkpoint.latest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.handoff.create"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.handoff.create"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.handoff.accept"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.handoff.accept"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.handoff.get"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.handoff.get"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.workflow.list"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.workflow.list"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.record"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.record"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.search"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.search"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.recall"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/input/memory.recall"
              }
            }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "required": [
        "kind",
        "capability",
        "output"
      ],
      "properties": {
        "kind": {
          "const": "memory-answer"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "output": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.checkpoint.write"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.checkpoint.write"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.checkpoint.latest"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.checkpoint.latest"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.handoff.create"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.handoff.create"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.handoff.accept"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.handoff.accept"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.handoff.get"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.handoff.get"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.workflow.list"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.workflow.list"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.record"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.record"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.search"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.search"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "memory.recall"
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/output/memory.recall"
                  },
                  {
                    "$ref": "#/$defs/refusal"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "refusal": {
      "type": "object",
      "required": [
        "error",
        "detail"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "remedy": {
          "type": "string"
        },
        "keptAs": {
          "type": "string"
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "reason"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "input": {
      "memory.checkpoint.write": {
        "type": "object",
        "required": [
          "owner",
          "idempotencyKey",
          "stepId",
          "status",
          "body"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^(agent|service):[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
            "description": "A self-named writer label. Never authority: identity comes from the transport (access binding)."
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
          },
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "status": {
            "enum": [
              "done",
              "failed",
              "in_progress",
              "blocked"
            ]
          },
          "body": {
            "type": "object",
            "required": [
              "goal"
            ],
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "plan": {
                "type": "array"
              },
              "done": {
                "type": "array"
              },
              "open": {
                "type": "array"
              },
              "decisions": {
                "type": "array"
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "artifacts": {
                "type": "array"
              },
              "credentials": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "project",
                    "env",
                    "name"
                  ],
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "env": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "purpose": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "questions": {
                "type": "array"
              },
              "memory_refs": {
                "type": "array"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Typed blocks, not prose. An unknown block is refused: state the next executor is not told to read does not travel."
          },
          "workflowId": {
            "type": "string",
            "pattern": "^wf_[0-9a-f]{16}$"
          },
          "leaseId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "The executor lease token; the only thing that tells two executors apart."
          },
          "projectId": {
            "type": "string",
            "pattern": "^project:[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "sessionId": {
            "type": "string"
          },
          "executor": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string"
              },
              "accountRef": {
                "type": "string"
              }
            },
            "required": [
              "provider"
            ],
            "additionalProperties": false
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "close": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "memory.checkpoint.latest": {
        "type": "object",
        "required": [
          "workflowId"
        ],
        "properties": {
          "workflowId": {
            "type": "string",
            "pattern": "^wf_[0-9a-f]{16}$"
          }
        },
        "additionalProperties": false
      },
      "memory.handoff.create": {
        "type": "object",
        "required": [
          "owner",
          "idempotencyKey",
          "workflowId",
          "to",
          "reason"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^(agent|service):[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
            "description": "A self-named writer label. Never authority: identity comes from the transport (access binding)."
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
          },
          "workflowId": {
            "type": "string",
            "pattern": "^wf_[0-9a-f]{16}$"
          },
          "to": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string"
              },
              "accountRef": {
                "type": "string"
              }
            },
            "required": [
              "provider"
            ],
            "additionalProperties": false
          },
          "reason": {
            "enum": [
              "limit",
              "crash",
              "restart",
              "operator",
              "plan_route"
            ]
          },
          "leaseId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "The executor lease token; the only thing that tells two executors apart."
          },
          "offerTtlSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800
          },
          "transcript": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "memory.handoff.accept": {
        "type": "object",
        "required": [
          "owner",
          "idempotencyKey",
          "handoffId"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^(agent|service):[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
            "description": "A self-named writer label. Never authority: identity comes from the transport (access binding)."
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
          },
          "handoffId": {
            "type": "string",
            "pattern": "^handoff:"
          },
          "executor": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string"
              },
              "accountRef": {
                "type": "string"
              }
            },
            "required": [
              "provider"
            ],
            "additionalProperties": false
          },
          "sessionId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "memory.handoff.get": {
        "type": "object",
        "required": [
          "handoffId"
        ],
        "properties": {
          "handoffId": {
            "type": "string",
            "pattern": "^handoff:"
          }
        },
        "additionalProperties": false
      },
      "memory.workflow.list": {
        "type": "object",
        "required": [],
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^project:[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "status": {
            "enum": [
              "open",
              "closed",
              "all"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "memory.record": {
        "type": "object",
        "required": [
          "owner",
          "statement"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^(agent|service):[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
            "description": "A self-named writer label. Never authority: identity comes from the transport (access binding)."
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "why": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "pattern": "^project:[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "sessionId": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memoryId": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "memory.search": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "projectId": {
            "type": "string",
            "pattern": "^project:[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "memory.recall": {
        "type": "object",
        "required": [],
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^project:[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "memory.checkpoint.write": {
        "type": "object",
        "required": [
          "workflowId",
          "memoryId",
          "revision",
          "stepId",
          "status"
        ],
        "properties": {
          "workflowId": {
            "type": "string",
            "pattern": "^wf_[0-9a-f]{16}$"
          },
          "memoryId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "stepId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "leaseId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "The executor lease token; the only thing that tells two executors apart."
          },
          "closed": {
            "type": "boolean"
          },
          "createdAt": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "additionalProperties": true
      },
      "memory.checkpoint.latest": {
        "type": "object",
        "required": [
          "workflowId",
          "status",
          "checkpoint",
          "degraded"
        ],
        "properties": {
          "workflowId": {
            "type": "string",
            "pattern": "^wf_[0-9a-f]{16}$"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "checkpoint": {
            "type": [
              "object",
              "null"
            ]
          },
          "credentials": {
            "type": "array"
          },
          "credentialsMissing": {
            "type": "boolean"
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "reason"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "memory.handoff.create": {
        "type": "object",
        "required": [
          "handoffId",
          "workflowId",
          "expiresAt",
          "degraded"
        ],
        "properties": {
          "handoffId": {
            "type": "string",
            "pattern": "^handoff:"
          },
          "workflowId": {
            "type": "string",
            "pattern": "^wf_[0-9a-f]{16}$"
          },
          "expiresAt": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "credentialsMissing": {
            "type": "boolean"
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "reason"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "memory.handoff.accept": {
        "type": "object",
        "required": [
          "handoffId",
          "workflowId",
          "leaseId",
          "pack",
          "constraints",
          "degraded"
        ],
        "properties": {
          "handoffId": {
            "type": "string"
          },
          "workflowId": {
            "type": "string",
