{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/interop-request-meta.schema.json",
  "title": "fabric-interop/0.1 request _meta (trace context)",
  "type": "object",
  "required": [
    "traceparent"
  ],
  "properties": {
    "traceparent": {
      "$ref": "interop-common.schema.json#/$defs/traceparent"
    },
    "tracestate": {
      "$ref": "interop-common.schema.json#/$defs/tracestate"
    },
    "baggage": {
      "type": "string",
      "maxLength": 8192
    },
    "protocols": {
      "$ref": "common.schema.json#/$defs/protocols",
      "description": "DEC-0087 (DEC-0067's list): the revisions the caller reads. A caller that names `fabric-interop/0.2` accepts `null` and `partial` in a job's `usage`; absent, it reads `fabric-interop/0.1`."
    }
  },
  "additionalProperties": true
}
